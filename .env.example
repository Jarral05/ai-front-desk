# Not needed to run locally: without these, the app uses a temporary in-memory database.
# In production, set these in the host's panel. Never commit real values.
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/front-desk
PUBLIC_URL=https://frontdesk-demo.example.com

# Added in Part 2. Make the key in Google AI Studio and type it in yourself.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional
# TRUST_PROXY=1
