# Not needed to run locally: without these, the app uses a temporary in-memory database.
# In production, set these in the host's panel. Never commit real values.
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/front-desk
PUBLIC_URL=https://frontdesk-demo.example.com

# Required in production. Make the key in Google AI Studio and type it in yourself.
# Without it, locally, the chat says it's switched off and bookings are saved "Unscored".
GEMINI_API_KEY=
# Optional, this is the default:
# GEMINI_MODEL=gemini-3.5-flash-lite

# The owner's sign-in. Required in production. Make the hash with: npm run hash-password
# (never put the password itself here). Without these, locally, the owner pages say sign-in isn't set up.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD_HASH=

# Optional
# TRUST_PROXY=1

# Optional: which business this copy shows. Leave both out for Maple Lane Physio.
# CLINIC_PROFILE=childrens-hospital
# A private profile kept outside this repository (it wins over CLINIC_PROFILE):
# CLINIC_PROFILE_FILE=../local-demos/some-hospital.json
