{
  "name": "ai-front-desk",
  "version": "0.1.0",
  "private": true,
  "description": "A demo AI front desk for a made-up clinic: an AI chat that answers from the clinic's facts and turns enquiries into scored leads.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web \"node --watch server.js\" \"vite\"",
    "build": "vite build",
    "postinstall": "vite build",
    "start": "node server.js",
    "test": "node --test --experimental-test-coverage \"tests/*.test.js\""
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "mongodb-memory-server-core": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
