{
  "name": "ai-front-desk",
  "version": "0.1.8",
  "private": true,
  "description": "A demo AI front desk for a made-up clinic: an AI chat that answers from the clinic's facts and turns enquiries into scored leads.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/check-ports.js",
    "dev": "concurrently -n api,web \"node --env-file-if-exists=.env --watch server.js\" \"vite\"",
    "predev:hospital": "node scripts/check-ports.js",
    "dev:hospital": "concurrently -n api,web \"node --env-file-if-exists=.env --env-file=demo-profiles/childrens-hospital.env --watch server.js\" \"vite\"",
    "predev:private": "node scripts/check-ports.js",
    "dev:private": "concurrently -n api,web \"node --env-file-if-exists=.env --env-file=../local-demos/private-demo.env --watch server.js\" \"vite\"",
    "stop": "node scripts/stop.js",
    "make-secret": "node scripts/make-secret.js",
    "build": "vite build",
    "postinstall": "vite build",
    "start": "node server.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "node --test --experimental-test-coverage \"tests/*.test.js\""
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@google/genai": "^3.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.1.0",
    "vite": "^8.3.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "mongodb-memory-server-core": "^11.3.0",
    "supertest": "^7.3.2"
  }
}
